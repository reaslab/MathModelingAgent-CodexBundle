% BibTeX 参考文献示例
% 每条记录必须包含 author, title, year 字段，否则 natbib 会报错。
% Every entry MUST have author, title, year fields, or natbib will error.

@article{example2024,
  author  = {Zhang, San and Li, Si},
  title   = {A Mathematical Modeling Approach for Optimization Problems},
  journal = {Journal of Applied Mathematics},
  year    = {2024},
  volume  = {10},
  pages   = {1--15},
}
